{
 "l0.7860442e": "Curso completo. 20 lecciones. Cada lección: vocabulario + gramática + ejercicios.",
 "l0.f382537f": "**Lecciones 1-10**: básico (pronunciación → composición). **Lecciones 11-20**: intermedio (causativo, voz, evidencialidad, honoríficos, subordinación, comparativo, numerales avanzados, calendario, conversación, creación de palabras).",
 "l1.052f1d48": "\"¿estás bien?\"",
 "l1.10fef620": "Español",
 "l1.1900a5f7": "\"hola, tú\"",
 "l1.1b7e1d3a": "\"casa\"",
 "l1.1f5520c6": "Tapi usa 9 letras: `a, i, u, k, m, n, p, s, t`. Cada letra = un sonido. Sin excepciones.",
 "l1.219c89da": "\"estoy bien\"",
 "l1.260c46ca": "Pronuncia: `mati-mati`, `tunu-puka`, `kapa-kupa`.",
 "l1.36a2c425": "hola (vocativo)",
 "l1.3dba7809": "Frases",
 "l1.3f332ce5": "\"sol\"",
 "l1.44505746": "tú/usted",
 "l1.4829322d": "yo",
 "l1.4a55b475": "Vocabulario",
 "l1.50254161": "Traduce: \"¿estás mal?\"",
 "l1.5ca6fcff": "\"tú\"",
 "l1.5ff50cfc": "\"pie\"",
 "l1.692c61d6": "\"no\"",
 "l1.8b520c90": "Sonidos",
 "l1.8c5e32f4": "\"luna\"",
 "l1.97672199": "Lección 1 — Pronunciación y saludo",
 "l1.a7b2937d": "Siempre en la penúltima sílaba: ka**ma**, pa**ti**, ta**pi**.",
 "l1.b30fe35f": "\"mano\"",
 "l1.b56c581c": "Respuesta: `tu muka ku`",
 "l1.b791d552": "Sonido como en",
 "l1.bc5694d9": "Regla de acento",
 "l1.cfd1e384": "Tapi",
 "l1.e2e6c938": "bueno",
 "l1.ec66b4a3": "\"vida\"",
 "l1.f3cf4433": "Ejercicios",
 "l1.fe986655": "Letra",
 "l10.034f5409": "casa-ala = avión",
 "l10.05bc7886": "corazón-grande = coraje",
 "l10.1be91db1": "\"Hospital\" → `puti-tina-kama` (cuerpo-bueno-casa) o `naka-kama`",
 "l10.26a5abfd": "Palabras complejas = raíces simples unidas con guion.",
 "l10.2aed2568": "sol-fuego = calor",
 "l10.31f96331": "Principio",
 "l10.404d5bef": "pensamiento-largo",
 "l10.475c4209": "Crea tus palabras",
 "l10.481e4a14": "\"Bicicleta\" → `mana-puta` (redondo-pie)",
 "l10.55779eb1": "Traduce al Tapi, usando compuestos:",
 "l10.56603e6d": "saber-dar = profesor",
 "l10.63f40b36": "Ejemplos clásicos:",
 "l10.6b25bffe": "\"Aeropuerto\" → `kama-titu-kama` (avión-casa)",
 "l10.732b452c": "Ejemplo: \"saudade\" (añoranza) no tiene palabra directa. Posibles compuestos:",
 "l10.736875cf": "Ejercicio final",
 "l10.acaedb0a": "corazón-vuelta",
 "l10.b2e8f164": "tiempo-negación",
 "l10.d426691e": "Lección 10 — Composición (el alma del Tapi)",
 "l10.df5dd4a7": "palabra-larga = teléfono",
 "l10.f5e910db": "\"Felicidad\" → `pumu-tina`",
 "l10.f78934c9": "Combina raíces para formar conceptos. Los hablantes entienden por contexto.",
 "l11.10fef620": "Español",
 "l11.18b7aedc": "\"La lluvia hará crecer la planta\" → `masu patuka kipi tipi`",
 "l11.19b624e9": "\"harás dormir al niño\"",
 "l11.319ac7ae": "Causativo = \"hacer X\". En Tapi: `patu` (hacer) + verbo.",
 "l11.3d3cd5cd": "El tiempo va en el verbo `patu`, no en el principal:",
 "l11.46dc33ac": "\"la madre hace dormir al niño\"",
 "l11.4a55b475": "Vocabulario",
 "l11.5153cd83": "Lección 11 — Causativo",
 "l11.67528e5a": "obligar (lit. deber-hacer)",
 "l11.7ddc9575": "\"Me hicieron reír\" → `kupi patuta mi tasi`",
 "l11.83d76e7f": "\"el profesor hace saber a la persona\" (= enseña)",
 "l11.968db0cb": "matar (= patu kina, pero raíz corta)",
 "l11.b3884c47": "\"lo hice comer (ayer)\"",
 "l11.bd3e0f5f": "hacer (causativo)",
 "l11.c87c951b": "\"lo hice comer\"",
 "l11.cfd1e384": "Tapi",
 "l11.e5b8d17b": "Estructura",
 "l11.e87b32ab": "`SUJ + patu + OBJETIVO + VERBO`.",
 "l11.f3cf4433": "Ejercicios",
 "l12.04f3381b": "Activa: `si mani kasi` = \"él come la comida\"",
 "l12.0f1d861c": "\"el libro fue escrito por muchas personas\"",
 "l12.12a28a47": "Pasiva: `kasi mani-pa mu si` = \"la comida es comida por él\"",
 "l12.2a3586b5": "\"la comida fue comida por él\"",
 "l12.50f62116": "`OBJETO + VERBO + mu + AGENTE`.",
 "l12.5e59093b": "\"Suanu fue visto por la madre\" → `Suanu tikata mu mama`",
 "l12.ac4fb66f": "Sin `mu`: pasiva impersonal.",
 "l12.af87cd2c": "Lección 12 — Voz pasiva",
 "l12.c350c950": "\"la casa fue hecha\" (por alguien no dicho)",
 "l12.c9595b8f": "Invierte sujeto y objeto. La partícula `mu` marca el agente.",
 "l12.d75644fe": "\"El árbol fue cortado\" → `tipa sasita`",
 "l12.d78a1d07": "Agente desconocido",
 "l12.e5b8d17b": "Estructura",
 "l12.f3cf4433": "Ejercicios",
 "l12.fbbc5ba4": "Comparar:",
 "l13.0ba520d3": "`manita-ni` (debió de comer — vi los platos sucios)",
 "l13.0e23e5c5": "∅ (nada)",
 "l13.10fef620": "Español",
 "l13.12efe565": "Cuándo usar",
 "l13.226ed3c2": "\"Vi que durmió\" → `napita`",
 "l13.30f97a51": "Ejemplo",
 "l13.3107f050": "ver (raíz de la evidencia directa)",
 "l13.34c4a1b8": "Inferí por evidencia",
 "l13.46e18882": "Sufijo",
 "l13.4a55b475": "Vocabulario",
 "l13.4dc85172": "Rumor: `-ni-ku` (dudoso)",
 "l13.4fe4525a": "`manita` (comió, yo lo vi)",
 "l13.60694dcc": "\"Quizá haya venido\" → `unata-ni-ku`",
 "l13.75ddcd3e": "Testimonio directo: ∅",
 "l13.86c5286f": "Noticias: `-ni-ni` (reportado)",
 "l13.c0145067": "Me lo contaron",
 "l13.c1c6bd7b": "Investigación: `-ni` (inferencia)",
 "l13.c20511da": "mentira (lit. verdad-NEG)",
 "l13.c2d553f7": "Lo dudo",
 "l13.c7efdebd": "verdad",
 "l13.caf47c81": "`manita-ni-ni` (dijeron que comió)",
 "l13.ce14c060": "\"Dicen que llovió\" → `masuta-ni-ni`",
 "l13.cfd1e384": "Tapi",
 "l13.d78e3c05": "Lo vi/viví directamente",
 "l13.e781f99a": "`manita-ni-ku` (quizá haya comido, no sé)",
 "l13.eba6c29c": "Significado",
 "l13.f2f9dcc1": "Marca **cómo sabes** aquello de lo que hablas. Se une al verbo (generalmente en pasado).",
 "l13.f3cf4433": "Ejercicios",
 "l13.f4c7f29d": "Lección 13 — Evidencialidad",
 "l14.12efe565": "Cuándo usar",
 "l14.13f3c743": "Pronombres formales",
 "l14.19273190": "Vocativo formal",
 "l14.1b32db0e": "Primera interacción con un desconocido mayor",
 "l14.1d1648e1": "Lección 14 — Honoríficos",
 "l14.1d8c515b": "usted (formal, lit. tú-superior)",
 "l14.25885c21": "Contexto profesional formal",
 "l14.2747159c": "Registros formales. Tapi usa sufijos y formas dedicadas.",
 "l14.288029d0": "Sufijo de respeto `-sami`",
 "l14.463969fc": "yo (humilde, lit. yo-pequeño)",
 "l14.600f847a": "jefe (respetuoso)",
 "l14.6658eaff": "\"Yo, humildemente, agradezco\" → `mi-puku taka-tina sami`",
 "l14.666980ce": "señor (lit. padre-superior)",
 "l14.82e94bb6": "Añadido a sustantivos sociales:",
 "l14.9693f6e3": "\"Buenos días, señora\" → `tunu-una tina, mama-sami`",
 "l14.9ae224d7": "profesor (respetuoso)",
 "l14.a3f15aba": "Ceremonias",
 "l14.ad1e45be": "Texto escrito formal (cartas, declaraciones)",
 "l14.b9762931": "Entre íntimos o pares: forma simple.",
 "l14.d0a169f8": "`na, papi-sami` = \"Señor, ...\" `na, mama-sami` = \"Señora, ...\"",
 "l14.f3cf4433": "Ejercicios",
 "l14.ff01ff70": "señora (lit. madre-superior)",
 "l15.0c27327a": "`mi tasi miku tu una` (río porque viniste)",
 "l15.12e52314": "\"si llovió, no fui\"",
 "l15.1b94a681": "Tiempo solo en la oración principal — la subordinada hereda el contexto.",
 "l15.1f90884a": "`asi pa X, Y` = \"si no fuera por X, Y\".",
 "l15.2e790236": "mientras",
 "l15.30f97a51": "Ejemplo",
 "l15.3f1aac96": "\"Estudio mientras llueve\" → `mi kima-kapa pamu masu`",
 "l15.45f61d46": "porque",
 "l15.6b4851f1": "Concordancia de tiempo",
 "l15.6d10266d": "Lección 15 — Subordinación",
 "l15.6e7eb6ee": "que (relativo)",
 "l15.7354ba40": "`mati ta una` (persona que vino)",
 "l15.7a16c83f": "si (condicional)",
 "l15.805ea36c": "\"si no fueras tú, yo moriría\"",
 "l15.83630a4b": "\"Comeré si tengo comida\" → `mi manika asi mi nuta kasi`",
 "l15.970a9978": "`pamu tu napi, mi patu` (mientras duermes, yo trabajo)",
 "l15.9b91c524": "Causa contrafactual",
 "l15.abe326c1": "cuando (general)",
 "l15.c10746ea": "`asi tu una, mi tasi` (si vienes, yo río)",
 "l15.cfd1e384": "Tapi",
 "l15.d908877d": "\"cuando viniste, yo dormía\"",
 "l15.df0cd085": "Las conjunciones subordinantes combinan oraciones.",
 "l15.e2d7bba6": "\"Hablo porque sé\" → `mi taka miku mi kima`",
 "l15.eba6c29c": "Significado",
 "l15.f3cf4433": "Ejercicios",
 "l15.f4a2f89c": "`upa masu, mi mipa kama` (cuando llueve, me quedo en casa)",
 "l16.00b4bbb6": "Lección 16 — Comparativo y superlativo",
 "l16.0330a512": "Lo inverso: usar `pa-sa`.",
 "l16.10fef620": "Español",
 "l16.14643cfd": "\"camino más lejos que tú\"",
 "l16.156f04fd": "\"esta casa es más grande que esa\"",
 "l16.43831b1e": "Comparativo `sa`",
 "l16.45fa570b": "\"soy más pequeño que tú\" (lit. pequeño \"menos-que\" tú)",
 "l16.4a55b475": "Vocabulario",
 "l16.5254e635": "superlativo",
 "l16.620bb639": "comparativo (más)",
 "l16.6bf24f1b": "Añadido al adjetivo.",
 "l16.8010c705": "`X sa Y` = \"X más que Y\".",
 "l16.8773dd44": "\"El más fuerte del mundo\" → `musu-tipi sami ni nuki`",
 "l16.922fb303": "igual",
 "l16.97f2a729": "\"el más bello del bosque\"",
 "l16.9e4b4249": "Igualdad `tani-tani`",
 "l16.9f7115df": "menos (compuesto)",
 "l16.ad354042": "\"Más dulce que la miel\" → `suma sa muma-mina-kuma`",
 "l16.cfd1e384": "Tapi",
 "l16.d24c94b7": "\"el más grande\"",
 "l16.e4cd4556": "\"soy igual a ti en tamaño\"",
 "l16.e63995c3": "Superlativo `sami`",
 "l16.f2bb76ed": "\"Igual al padre\" → `tani-tani papi`",
 "l16.f3cf4433": "Ejercicios",
 "l17.04ad3ee6": "diez veces",
 "l17.0d63db9d": "primero",
 "l17.0ed6011d": "dos veces",
 "l17.1679091c": "6",
 "l17.26b5731e": "\"Cinco veces al día\" → `ka-kapa pasi nupa`",
 "l17.2b7b1077": "segundo",
 "l17.34173cb3": "30",
 "l17.3c59dc04": "21",
 "l17.4384570e": "tres quintos (3/5)",
 "l17.45c48cce": "9",
 "l17.545f3927": "Compuesto: `decena-unidad`. Ej.: `pi-nuna-ka` = 25.",
 "l17.61c63e96": "\"X de Y\" = X partes de Y.",
 "l17.63925488": "Ordinal (`ku-`)",
 "l17.64904013": "Lección 17 — Numerales avanzados",
 "l17.6512bd43": "11",
 "l17.6d16b8d4": "Cardinal",
 "l17.725f85b3": "tercero",
 "l17.85af0095": "un cuarto (1/4)",
 "l17.8f14e45f": "7",
 "l17.91990a2f": "\"Tercer hijo\" → `ku-ti kuni`",
 "l17.98f13708": "20",
 "l17.9e2875f6": "\"Medio kilo\" (½) → `tani-ni-pi`",
 "l17.a87ff679": "4",
 "l17.a9b7ba70": "1000",
 "l17.b49b5676": "un medio (1/2)",
 "l17.bbe3142b": "\"X veces\" = X-tiempos.",
 "l17.c20ad4d7": "12",
 "l17.c4ca4238": "1",
 "l17.c81e728d": "2",
 "l17.c9f0f895": "8",
 "l17.cbdeb5e6": "Fracción `X-ni-Y`",
 "l17.cfcd2084": "0",
 "l17.cfd1e384": "Tapi",
 "l17.d3d94468": "10",
 "l17.db14dbef": "Multiplicación `X-kapa`",
 "l17.e4da3b7f": "5",
 "l17.ea1f2537": "décimo",
 "l17.eccbc87e": "3",
 "l17.f3cf4433": "Ejercicios",
 "l17.f452fff3": "Número",
 "l17.f899139d": "100",
 "l18.06e57a7d": "viernes",
 "l18.0a249678": "Noche: `muta-pi tina`",
 "l18.10cbe219": "lunes",
 "l18.10fef620": "Español",
 "l18.26255c47": "martes",
 "l18.2a3f41c2": "jueves",
 "l18.2f43b42f": "...",
 "l18.48f8c43d": "Estaciones",
 "l18.4ad462ef": "(Lista completa en [cultura.md](cultura.md))",
 "l18.54edec8d": "Hora del día",
 "l18.6003a292": "\"Viernes por la noche\" → `nupa-ma muta-pi`",
 "l18.61d90363": "\"La próxima primavera\" → `kipi-kapa kini` (lit. primavera nueva)",
 "l18.635c1594": "\"Buenas tardes, señor\" → `nupa tina, papi-sami`",
 "l18.66d17981": "mediodía",
 "l18.6d33d66f": "primavera (flor-tiempo)",
 "l18.78ab84de": "enero",
 "l18.7af763b2": "invierno (frío-tiempo)",
 "l18.84736276": "noche",
 "l18.8f647435": "tarde",
 "l18.8febbfd1": "febrero",
 "l18.941016d5": "Días de la semana",
 "l18.969d64f4": "mañana",
 "l18.98f97844": "verano (calor-tiempo)",
 "l18.99c8ef57": "aurora",
 "l18.9a36cd6a": "Tarde: `nupa tina`",
 "l18.a42b3364": "Despedida: `kuti tina` (buen regreso)",
 "l18.ad5fb7bc": "miércoles",
 "l18.b32018bb": "Saludos según la hora",
 "l18.be2fc0a0": "Mañana: `tunu-una tina`",
 "l18.bf957b38": "crepúsculo",
 "l18.cf1624fc": "marzo",
 "l18.cfd1e384": "Tapi",
 "l18.dc123bc5": "sábado",
 "l18.e59da2d2": "diciembre",
 "l18.e6694818": "otoño (hoja-caer)",
 "l18.e6a1c434": "Meses (lit. luna-tiempo-X)",
 "l18.ecd42804": "Lección 18 — Calendario y tiempo",
 "l18.f3cf4433": "Ejercicios",
 "l18.f642fa88": "domingo",
 "l18.f817c12d": "medianoche",
 "l19.12a0f2d6": "¿puedes ...?",
 "l19.2d54a2d4": "``` Tú: na! mi pa kima nani. tu puni ama-puna mi ku? Tú: ¡Hola! No conozco el camino. ¿Puedes ayudarme?",
 "l19.32023bc0": "va bien",
 "l19.35b95baa": "bien, gracias",
 "l19.3a077c79": "Saludos",
 "l19.41691ce5": "cómo estás (lit. así-modo)",
 "l19.470819ef": "Lección 19 — Conversación práctica",
 "l19.4c8b7feb": "¿estás bien?",
 "l19.55aee164": "Despídete de tres maneras diferentes.",
 "l19.561c5caf": "Tú: tina-tina sami! Tú: ¡Muchas gracias! ```",
 "l19.610ad8d7": "Diálogo modelo (turista)",
 "l19.6d267c99": "Peticiones",
 "l19.70afc441": "da ...",
 "l19.740a78da": "hasta pronto (lit. ver-de-nuevo)",
 "l19.74c8f317": "Despedidas",
 "l19.7646529c": "Agradecimiento y disculpas",
 "l19.79d50daa": "de nada",
 "l19.7da3a6dc": "hola (vocativo)",
 "l19.809e6b22": "quiero ...",
 "l19.83288a43": "encantado de conocerte",
 "l19.91ef8b38": "¿y tú?",
 "l19.925946e2": "Pide una indicación de camino.",
 "l19.9ebb5c99": "Presentación",
 "l19.a81f639d": "Él: ina-ti pasi nani-tipi mata, samu pasi ku-ti pinu-kapa. Él: Ve por la calle principal, a la derecha en la tercera esquina.",
 "l19.ad02875a": "muchas gracias",
 "l19.b6583976": "Tú: mi ina ipa-tipi-kama. Tú: Voy al hospital.",
 "l19.d027e466": "perdón (lit. decir-división)",
 "l19.e1654c11": "siempre bien",
 "l19.e5ebca86": "`mi ipa [nombre]` = soy [nombre]",
 "l19.f3cf4433": "Ejercicios",
 "l19.f5491d72": "gracias",
 "l19.fb10b733": "buen regreso",
 "l19.fd86eac4": "Él: mata-ipa. tu ina nika ku? Él: Claro. ¿Adónde vas?",
 "l19.fe6f27fd": "Preséntate en Tapi.",
 "l2.08176a75": "Negación con `pa` antes del verbo:",
 "l2.10fef620": "Español",
 "l2.15031bc0": "\"¿Son personas?\" → `kupi ipa mati-mati ku`",
 "l2.1e6e6087": "Frase simple: `SUJETO + VERBO + COMPLEMENTO`.",
 "l2.202719a7": "nosotros",
 "l2.31932660": "no",
 "l2.38ba62ab": "él/ella",
 "l2.4a55b475": "Vocabulario",
 "l2.672ca8c8": "vosotros/ustedes",
 "l2.697e5b10": "\"soy persona\"",
 "l2.717a42ba": "Lección 2 — Yo, tú, él",
 "l2.81346868": "(partícula de pregunta)",
 "l2.8ba94fb6": "\"eres hombre\"",
 "l2.955cb48d": "ellos/ellas",
 "l2.9c1a1cf5": "\"Él es bueno\" → `si ipa tina`",
 "l2.c6682b48": "Cópula `ipa` para identidad:",
 "l2.cfd1e384": "Tapi",
 "l2.e03184d6": "\"No somos malos\" → `nupi pa ipa muka`",
 "l2.e5c3aa55": "Gramática",
 "l2.f3cf4433": "Ejercicios",
 "l2.f3efc625": "ser/estar",
 "l2.f5bae9af": "\"no soy malo\"",
 "l20.115f46f6": "`kama-tunu` (casa-sol)",
 "l20.12c5ae51": "órgano-acción",
 "l20.260d58ea": "terraza soleada",
 "l20.2e6e1a09": "**Nevera** → ?",
 "l20.30f97a51": "Ejemplo",
 "l20.3e60c065": "acción-objeto",
 "l20.4966c32e": "Principios",
 "l20.499afc2b": "Comparte tus creaciones con la comunidad.",
 "l20.4bdf449f": "Lección 20 — Crear palabras nuevas",
 "l20.4cc1837a": "\"Saudade\" (añoranza) → `pumu-kana` (corazón + lejos)",
 "l20.511746aa": "lugar-cosa",
 "l20.523677e0": "comida (acto de comer)",
 "l20.56f2fc07": "Ejemplos de creación",
 "l20.66c9eed1": "foto",
 "l20.683511e7": "**Cumpleaños** → ?",
 "l20.6cdaf07f": "**Guion** entre componentes",
 "l20.736875cf": "Ejercicio final",
 "l20.761121ed": "Traducción",
 "l20.7642e793": "**Longitud aceptable**: 2-5 componentes",
 "l20.842ea432": "El **contexto** completa el resto",
 "l20.926addd7": "Crea palabras Tapi para:",
 "l20.99d610ec": "cualidad-cosa",
 "l20.9c1c65b4": "\"Burnout\" → `puti-kupa-pa` (cuerpo-todo-NEG)",
 "l20.9f02a72b": "El **significado literal** debe sugerir el concepto",
 "l20.a5efde29": "objeto-función",
 "l20.a6a31716": "**Usa raíces existentes** antes de inventar",
 "l20.aabc2217": "Patrones frecuentes",
 "l20.ad36fe14": "`tipi-mina` (grande-agua)",
 "l20.adcba148": "bola de piedra",
