 "l1.e2e6c938": "good",
 "l1.ec66b4a3": "\"machine\"",
 "l1.f3cf4433": "Exercises",
 "l1.fe986655": "Letter",
 "l10.034f5409": "house-wing = airplane",
 "l10.05bc7886": "heart-big = courage",
 "l10.1be91db1": "\"Hospital\" → `puti-tina-kama` (body-good-house) or `naka-kama`",
 "l10.26a5abfd": "Complex words = simple roots glued with a hyphen.",
