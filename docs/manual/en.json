 "l13.86c5286f": "News: `-ni-ni` (reported)",
 "l13.c0145067": "I was told",
 "l13.c1c6bd7b": "Investigation: `-ni` (inference)",
 "l13.c20511da": "lie (lit. truth-NEG)",
 "l13.c2d553f7": "I doubt it",
 "l13.c7efdebd": "truth",
 "l13.caf47c81": "`manita-ni-ni` (they say he ate)",
 "l13.ce14c060": "\"They say it rained\" → `masuta-ni-ni`",
 "l13.cfd1e384": "Tapi",
 "l13.d78e3c05": "I saw/experienced it directly",
 "l13.e781f99a": "`manita-ni-ku` (maybe he ate, I don't know)",
 "l13.eba6c29c": "Meaning",
 "l13.f2f9dcc1": "Marks **how you know** what you are talking about. Attaches to the verb (usually in the past).",
 "l13.f3cf4433": "Exercises",
