{
 "l0.7860442e": "Complete course. 20 lessons. Each lesson: vocabulary + grammar + exercises.",
 "l0.f382537f": "**Lessons 1-10**: basics (pronunciation → compounding). **Lessons 11-20**: intermediate (causative, voice, evidentiality, honorifics, subordination, comparative, advanced numerals, calendar, conversation, word creation).",
 "l1.052f1d48": "\"are you well?\"",
 "l1.10fef620": "English",
 "l1.1900a5f7": "\"hello, you\"",
 "l1.1b7e1d3a": "\"car\"",
 "l1.1f5520c6": "Tapi uses 9 letters: `a, i, u, k, m, n, p, s, t`. Each letter = one sound. No exceptions.",
 "l1.219c89da": "\"I am well\"",
 "l1.260c46ca": "Pronounce: `mati-mati`, `tunu-puka`, `kapa-kupa`.",
 "l1.36a2c425": "hello (vocative)",
 "l1.3dba7809": "Phrases",
 "l1.3f332ce5": "\"sun\"",
 "l1.44505746": "you",
 "l1.4829322d": "I",
