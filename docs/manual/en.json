 "l1.50254161": "Translate: \"are you bad?\"",
 "l1.5ca6fcff": "\"stop\"",
 "l1.5ff50cfc": "\"spin\"",
 "l1.692c61d6": "\"no\"",
 "l1.8b520c90": "Sounds",
 "l1.8c5e32f4": "\"flute\"",
 "l1.97672199": "Lesson 1 — Pronunciation and greeting",
 "l1.a7b2937d": "Always on the penultimate syllable: ka**ma**, pa**ti**, ta**pi**.",
 "l1.b30fe35f": "\"man\"",
 "l1.b56c581c": "Answer: `tu muka ku`",
 "l1.b791d552": "Sound as in",
 "l1.bc5694d9": "Stress rule",
