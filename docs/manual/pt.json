 "l17.3c59dc04": "21",
 "l17.4384570e": "três quintos (3/5)",
 "l17.45c48cce": "9",
 "l17.545f3927": "Composto: `dezena-unidade`. Ex.: `pi-nuna-ka` = 25.",
 "l17.61c63e96": "\"X de Y\" = X partes de Y.",
 "l17.63925488": "Ordinal (`ku-`)",
 "l17.64904013": "Lição 17 — Numerais avançados",
 "l17.6512bd43": "11",
 "l17.6d16b8d4": "Cardinal",
 "l17.725f85b3": "terceiro",
 "l17.85af0095": "um quarto (1/4)",
 "l17.8f14e45f": "7",
 "l17.91990a2f": "\"Terceiro filho\" → `ku-ti kuni`",
 "l17.98f13708": "20",
 "l17.9e2875f6": "\"Meio quilo\" (½) → `tani-ni-pi`",
 "l17.a87ff679": "4",
 "l17.a9b7ba70": "1000",
 "l17.b49b5676": "um meio (1/2)",
 "l17.bbe3142b": "\"X vezes\" = X-tempos.",
 "l17.c20ad4d7": "12",
 "l17.c4ca4238": "1",
 "l17.c81e728d": "2",
