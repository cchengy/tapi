 "l18.bf957b38": "crepúsculo",
 "l18.cf1624fc": "março",
 "l18.cfd1e384": "Tapi",
 "l18.dc123bc5": "sábado",
 "l18.e59da2d2": "dezembro",
 "l18.e6694818": "outono (folha-cair)",
 "l18.e6a1c434": "Meses (lit. lua-tempo-X)",
 "l18.ecd42804": "Lição 18 — Calendário e tempo",
 "l18.f3cf4433": "Exercícios",
 "l18.f642fa88": "domingo",
 "l18.f817c12d": "meia-noite",
 "l19.12a0f2d6": "podes ...?",
 "l19.2d54a2d4": "``` Tu:   na! mi pa kima nani. tu puni ama-puna mi ku? Você: Olá! Não sei o caminho. Podes me ajudar?",
 "l19.32023bc0": "vai bem",
 "l19.35b95baa": "bem, obrigado",
 "l19.3a077c79": "Cumprimentos",
 "l19.41691ce5": "como vai (lit. assim-modo)",
 "l19.470819ef": "Lição 19 — Conversação prática",
 "l19.4c8b7feb": "está bem?",
 "l19.55aee164": "Despeça-se de três maneiras diferentes.",
 "l19.561c5caf": "Tu:   tina-tina sami! Você: Muito obrigado! ```",
 "l19.610ad8d7": "Diálogo modelo (turista)",
 "l19.6d267c99": "Pedidos",
 "l19.70afc441": "dá ...",
 "l19.740a78da": "até logo (lit. ver-de-novo)",
 "l19.74c8f317": "Despedidas",
 "l19.7646529c": "Agradecimento e desculpas",
 "l19.79d50daa": "de nada",
 "l19.7da3a6dc": "oi (vocativo)",
 "l19.809e6b22": "quero ...",
 "l19.83288a43": "bom te conhecer",
 "l19.91ef8b38": "e tu?",
 "l19.925946e2": "Peça uma indicação de caminho.",
 "l19.9ebb5c99": "Apresentação",
 "l19.a81f639d": "Si:   ina-ti pasi nani-tipi mata, samu pasi ku-ti pinu-kapa. Ele:  Vai pela rua principal, direita na terceira esquina.",
 "l19.ad02875a": "muito obrigado",
 "l19.b6583976": "Tu:   mi ina ipa-tipi-kama. Você: Vou ao hospital.",
 "l19.d027e466": "desculpa (lit. dizer-divisão)",
 "l19.e1654c11": "sempre bem",
 "l19.e5ebca86": "`mi ipa [nome]` = sou [nome]",
 "l19.f3cf4433": "Exercícios",
 "l19.f5491d72": "obrigado",
 "l19.fb10b733": "boa volta",
 "l19.fd86eac4": "Si:   mata-ipa. tu ina nika ku? Ele:  Claro. Para onde vais?",
 "l19.fe6f27fd": "Apresente-se em Tapi.",
 "l2.08176a75": "Negação com `pa` antes do verbo:",
 "l2.10fef620": "Português",
 "l2.15031bc0": "\"Eles são pessoas?\" → `kupi ipa mati-mati ku`",
 "l2.1e6e6087": "Frase simples: `SUJEITO + VERBO + COMPLEMENTO`.",
 "l2.202719a7": "nós",
 "l2.31932660": "não",
 "l2.38ba62ab": "ele/ela",
 "l2.4a55b475": "Vocabulário",
 "l2.672ca8c8": "vós",
 "l2.697e5b10": "\"sou pessoa\"",
 "l2.717a42ba": "Lição 2 — Eu, tu, ele",
 "l2.81346868": "(partícula de pergunta)",
 "l2.8ba94fb6": "\"és homem\"",
 "l2.955cb48d": "eles/elas",
 "l2.9c1a1cf5": "\"Ele é bom\" → `si ipa tina`",
 "l2.c6682b48": "Cópula `ipa` para identidade:",
 "l2.cfd1e384": "Tapi",
 "l2.e03184d6": "\"Nós não somos maus\" → `nupi pa ipa muka`",
 "l2.e5c3aa55": "Gramática",
 "l2.f3cf4433": "Exercícios",
 "l2.f3efc625": "ser/estar",
 "l2.f5bae9af": "\"não sou mau\"",
 "l20.115f46f6": "`kama-tunu` (casa-sol)",
 "l20.12c5ae51": "órgão-ação",
 "l20.260d58ea": "varanda ensolarada",
 "l20.2e6e1a09": "**Geladeira** → ?",
 "l20.30f97a51": "Exemplo",
 "l20.3e60c065": "ação-objeto",
 "l20.4966c32e": "Princípios",
 "l20.499afc2b": "Compartilhe suas criações com a comunidade.",
 "l20.4bdf449f": "Lição 20 — Criar palavras novas",
 "l20.4cc1837a": "\"Saudade\" → `pumu-kana` (coração + longe)",
 "l20.511746aa": "lugar-coisa",
 "l20.523677e0": "refeição",
 "l20.56f2fc07": "Exemplos de criação",
 "l20.66c9eed1": "foto",
 "l20.683511e7": "**Aniversário** → ?",
 "l20.6cdaf07f": "**Hífen** entre componentes",
 "l20.736875cf": "Exercício final",
 "l20.761121ed": "Tradução",
 "l20.7642e793": "**Comprimento aceitável**: 2-5 componentes",
 "l20.842ea432": "**Contexto** completa o resto",
 "l20.926addd7": "Crie palavras Tapi para:",
 "l20.99d610ec": "qualidade-coisa",
 "l20.9c1c65b4": "\"Burnout\" → `puti-kupa-pa` (corpo-todo-NEG)",
 "l20.9f02a72b": "**Significado literal** deve sugerir o conceito",
 "l20.a5efde29": "objeto-função",
 "l20.a6a31716": "**Use raízes existentes** antes de inventar",
 "l20.aabc2217": "Padrões frequentes",
 "l20.ad36fe14": "`tipi-mina` (grande-água)",
 "l20.adcba148": "bola de pedra",
 "l20.b1bb9b4c": "Tapi é **vivo na composição**. Quando uma palavra falta, você compõe.",
 "l20.be31dfe5": "material-forma",
 "l20.be9b5ac7": "**Saudade do futuro** → ?",
 "l20.c068e077": "**Espelho** → ?",
 "l20.c29c85c0": "`tama-naku` (palavra-raiz)",
 "l20.c779cd57": "(Propostas: `kasi-kama-pini` / `kupu-mapu-pita` / `nupa-sasu-kapa` / `pati-mapu` / `pumu-nupa-maku-ka`)",
 "l20.cc16a92b": "\"Inteligência artificial\" → `patu-pita` (feito + pensar)",
 "l20.cdeaabf1": "`mani-kasi` (comer-comida)",
 "l20.d7114874": "`mapu-mana` (pedra-redonda)",
 "l20.da8f7ecf": "\"Internet\" → `tama-kupa` (palavra + tudo)",
 "l20.e2effa3a": "Padrão",
 "l20.e3de2cf8": "oceano",
 "l20.e6300758": "\"Selfie\" → `pati-tika-ku` (foto + reflexivo)",
 "l20.ea32f911": "livro",
 "l20.eee32656": "**Algoritmo** → ?",
 "l20.fa942b2a": "\"Podcast\" → `tama-na-tama-kupa` (canção + internet, ou tama-pami-kuta = palavra-longa-pegar)",
 "l20.fb72df4b": "`pati-tika` (olho-ver)",
