{
 "l0.7860442e": "Curso completo. 20 lições. Cada lição: vocabulário + gramática + exercícios.",
 "l0.f382537f": "**Lições 1-10**: básico (pronúncia → composição). **Lições 11-20**: intermediário (causativo, voz, evidencialidade, honoríficos, subordinação, comparativo, numerais avançados, calendário, conversação, criação de palavras).",
 "l1.052f1d48": "\"tu estás bem?\"",
 "l1.10fef620": "Português",
 "l1.1900a5f7": "\"olá, tu\"",
 "l1.1b7e1d3a": "\"casa\"",
 "l1.1f5520c6": "Tapi usa 9 letras: `a, i, u, k, m, n, p, s, t`. Cada letra = um som. Sem exceções.",
 "l1.219c89da": "\"estou bem\"",
 "l1.260c46ca": "Pronuncie: `mati-mati`, `tunu-puka`, `kapa-kupa`.",
 "l1.36a2c425": "olá (vocativo)",
 "l1.3dba7809": "Frases",
 "l1.3f332ce5": "\"sol\"",
 "l1.44505746": "tu/você",
 "l1.4829322d": "eu",
 "l1.4a55b475": "Vocabulário",
 "l1.50254161": "Traduza: \"tu estás mau?\"",
 "l1.5ca6fcff": "\"tá\"",
 "l1.5ff50cfc": "\"pé\"",
 "l1.692c61d6": "\"não\"",
 "l1.8b520c90": "Sons",
 "l1.8c5e32f4": "\"luz\"",
 "l1.97672199": "Lição 1 — Pronúncia e cumprimento",
 "l1.a7b2937d": "Sempre na penúltima sílaba: ka**ma**, pa**ti**, ta**pi**.",
 "l1.b30fe35f": "\"mão\"",
 "l1.b56c581c": "Resposta: `tu muka ku`",
 "l1.b791d552": "Som como em",
 "l1.bc5694d9": "Regra de acento",
 "l1.cfd1e384": "Tapi",
 "l1.e2e6c938": "bom",
 "l1.ec66b4a3": "\"vida\"",
 "l1.f3cf4433": "Exercícios",
 "l1.fe986655": "Letra",
 "l10.034f5409": "casa-asa = avião",
 "l10.05bc7886": "coração-grande = coragem",
 "l10.1be91db1": "\"Hospital\" → `puti-tina-kama` (corpo-bom-casa) ou `naka-kama`",
 "l10.26a5abfd": "Palavras complexas = raízes simples coladas com hífen.",
 "l10.2aed2568": "sol-fogo = calor",
 "l10.31f96331": "Princípio",
 "l10.404d5bef": "pensamento-longo",
 "l10.475c4209": "Crie suas palavras",
 "l10.481e4a14": "\"Bicicleta\" → `mana-puta` (redondo-pé)",
 "l10.55779eb1": "Traduza para Tapi, usando compostos:",
 "l10.56603e6d": "saber-dar = professor",
 "l10.63f40b36": "Exemplos clássicos:",
 "l10.6b25bffe": "\"Aeroporto\" → `kama-titu-kama` (avião-casa)",
 "l10.732b452c": "Exemplo: \"saudade\" não tem palavra direta. Possíveis compostos:",
 "l10.736875cf": "Exercício final",
 "l10.acaedb0a": "coração-volta",
 "l10.b2e8f164": "tempo-negação",
 "l10.d426691e": "Lição 10 — Composição (a alma do Tapi)",
 "l10.df5dd4a7": "palavra-longa = telefone",
 "l10.f5e910db": "\"Felicidade\" → `pumu-tina`",
 "l10.f78934c9": "Combine raízes para formar conceitos. Falantes entendem por contexto.",
 "l11.10fef620": "Português",
 "l11.18b7aedc": "\"A chuva fará a planta crescer\" → `masu patuka kipi tipi`",
 "l11.19b624e9": "\"tu farás filho dormir\"",
 "l11.319ac7ae": "Causativo = \"fazer X-er\". Em Tapi: `patu` (fazer) + verbo.",
 "l11.3d3cd5cd": "Tempo no verbo `patu`, não no principal:",
 "l11.46dc33ac": "\"mãe faz filho dormir\"",
 "l11.4a55b475": "Vocabulário",
 "l11.5153cd83": "Lição 11 — Causativo",
 "l11.67528e5a": "obrigar (lit. dever-fazer)",
 "l11.7ddc9575": "\"Eles me fizeram rir\" → `kupi patuta mi tasi`",
 "l11.83d76e7f": "\"professor faz pessoa saber\" (= ensina)",
 "l11.968db0cb": "matar (= patu kina, mas raiz curta)",
 "l11.b3884c47": "\"fiz ele comer (ontem)\"",
 "l11.bd3e0f5f": "fazer (causativo)",
 "l11.c87c951b": "\"fiz ele comer\"",
 "l11.cfd1e384": "Tapi",
 "l11.e5b8d17b": "Estrutura",
 "l11.e87b32ab": "`SUJ + patu + ALVO + VERBO`.",
 "l11.f3cf4433": "Exercícios",
 "l12.04f3381b": "Ativa: `si mani kasi` = \"ele come a comida\"",
 "l12.0f1d861c": "\"livro foi escrito por muitas pessoas\"",
 "l12.12a28a47": "Passiva: `kasi mani-pa mu si` = \"a comida está comida por ele\"",
 "l12.2a3586b5": "\"comida foi comida por ele\"",
 "l12.50f62116": "`OBJETO + VERBO + mu + AGENTE`.",
 "l12.5e59093b": "\"Suanu foi visto pela mãe\" → `Suanu tikata mu mama`",
 "l12.ac4fb66f": "Sem `mu`: passiva impessoal.",
 "l12.af87cd2c": "Lição 12 — Voz passiva",
 "l12.c350c950": "\"a casa foi feita\" (por alguém não dito)",
 "l12.c9595b8f": "Inverte sujeito e objeto. Partícula `mu` marca agente.",
 "l12.d75644fe": "\"A árvore foi cortada\" → `tipa sasita`",
 "l12.d78a1d07": "Agente desconhecido",
 "l12.e5b8d17b": "Estrutura",
 "l12.f3cf4433": "Exercícios",
 "l12.fbbc5ba4": "Comparar:",
 "l13.0ba520d3": "`manita-ni` (devia ter comido — vi os pratos sujos)",
 "l13.0e23e5c5": "∅ (nada)",
 "l13.10fef620": "Português",
 "l13.12efe565": "Quando usar",
 "l13.226ed3c2": "\"Vi que dormiu\" → `napita`",
 "l13.30f97a51": "Exemplo",
 "l13.3107f050": "ver (raiz da evidência direta)",
 "l13.34c4a1b8": "Inferi por evidência",
 "l13.46e18882": "Sufixo",
 "l13.4a55b475": "Vocabulário",
 "l13.4dc85172": "Boato: `-ni-ku` (duvidoso)",
 "l13.4fe4525a": "`manita` (comeu, eu vi)",
 "l13.60694dcc": "\"Talvez tenha vindo\" → `unata-ni-ku`",
 "l13.75ddcd3e": "Testemunho direto: ∅",
 "l13.86c5286f": "Notícias: `-ni-ni` (reportado)",
 "l13.c0145067": "Me contaram",
 "l13.c1c6bd7b": "Investigação: `-ni` (inferência)",
 "l13.c20511da": "mentira (lit. verdade-NEG)",
 "l13.c2d553f7": "Duvido",
 "l13.c7efdebd": "verdade",
 "l13.caf47c81": "`manita-ni-ni` (disseram que comeu)",
 "l13.ce14c060": "\"Dizem que choveu\" → `masuta-ni-ni`",
 "l13.cfd1e384": "Tapi",
 "l13.d78e3c05": "Vi/vivi diretamente",
 "l13.e781f99a": "`manita-ni-ku` (talvez tenha comido, não sei)",
 "l13.eba6c29c": "Significado",
 "l13.f2f9dcc1": "Marca **como você sabe** do que fala. Anexa-se ao verbo (geralmente no passado).",
 "l13.f3cf4433": "Exercícios",
 "l13.f4c7f29d": "Lição 13 — Evidencialidade",
 "l14.12efe565": "Quando usar",
 "l14.13f3c743": "Pronomes formais",
 "l14.19273190": "Vocativo formal",
 "l14.1b32db0e": "Primeira interação com estranho mais velho",
 "l14.1d1648e1": "Lição 14 — Honoríficos",
 "l14.1d8c515b": "você (formal, lit. tu-superior)",
 "l14.25885c21": "Contexto profissional formal",
 "l14.2747159c": "Registros formais. Tapi usa sufixos e formas dedicadas.",
 "l14.288029d0": "Sufixo de respeito `-sami`",
 "l14.463969fc": "eu (humilde, lit. eu-pequeno)",
 "l14.600f847a": "chefe (respeitoso)",
 "l14.6658eaff": "\"Eu, humildemente, agradeço\" → `mi-puku taka-tina sami`",
 "l14.666980ce": "senhor (lit. pai-superior)",
 "l14.82e94bb6": "Adicionado a substantivos sociais:",
 "l14.9693f6e3": "\"Bom dia, senhora\" → `tunu-una tina, mama-sami`",
 "l14.9ae224d7": "professor (respeitoso)",
 "l14.a3f15aba": "Cerimônias",
 "l14.ad1e45be": "Texto escrito formal (cartas, declarações)",
 "l14.b9762931": "Entre íntimos ou pares: forma simples.",
 "l14.d0a169f8": "`na, papi-sami` = \"Senhor, ...\" `na, mama-sami` = \"Senhora, ...\"",
 "l14.f3cf4433": "Exercícios",
 "l14.ff01ff70": "senhora (lit. mãe-superior)",
 "l15.0c27327a": "`mi tasi miku tu una` (rio porque vieste)",
 "l15.12e52314": "\"se choveu, não fui\"",
 "l15.1b94a681": "Tempo só na oração principal — subordinada herda contexto.",
 "l15.1f90884a": "`asi pa X, Y` = \"se não fosse X, Y\".",
 "l15.2e790236": "enquanto",
 "l15.30f97a51": "Exemplo",
 "l15.3f1aac96": "\"Estudo enquanto chove\" → `mi kima-kapa pamu masu`",
 "l15.45f61d46": "porque",
 "l15.6b4851f1": "Concordância de tempo",
 "l15.6d10266d": "Lição 15 — Subordinação",
 "l15.6e7eb6ee": "que (relativo)",
 "l15.7354ba40": "`mati ta una` (pessoa que veio)",
 "l15.7a16c83f": "se (condicional)",
 "l15.805ea36c": "\"se não fosses tu, eu morreria\"",
 "l15.83630a4b": "\"Comerei se tiver comida\" → `mi manika asi mi nuta kasi`",
 "l15.970a9978": "`pamu tu napi, mi patu` (enquanto dormes, eu trabalho)",
 "l15.9b91c524": "Causa contra-factual",
 "l15.abe326c1": "quando (geral)",
 "l15.c10746ea": "`asi tu una, mi tasi` (se vieres, eu rio)",
 "l15.cfd1e384": "Tapi",
 "l15.d908877d": "\"quando vieste, eu dormia\"",
 "l15.df0cd085": "Conjunções subordinadas combinam orações.",
 "l15.e2d7bba6": "\"Falo porque sei\" → `mi taka miku mi kima`",
 "l15.eba6c29c": "Significado",
 "l15.f3cf4433": "Exercícios",
 "l15.f4a2f89c": "`upa masu, mi mipa kama` (quando chove, fico em casa)",
 "l16.00b4bbb6": "Lição 16 — Comparativo e superlativo",
 "l16.0330a512": "Inverso: usar `pa-sa`.",
 "l16.10fef620": "Português",
 "l16.14643cfd": "\"ando mais longe que tu\"",
 "l16.156f04fd": "\"esta casa é maior que essa\"",
 "l16.43831b1e": "Comparativo `sa`",
 "l16.45fa570b": "\"sou menor que tu\" (lit. menor \"menos-que\" tu)",
 "l16.4a55b475": "Vocabulário",
 "l16.5254e635": "superlativo",
 "l16.620bb639": "comparativo (mais)",
 "l16.6bf24f1b": "Adicionado ao adjetivo.",
 "l16.8010c705": "`X sa Y` = \"X mais que Y\".",
 "l16.8773dd44": "\"O mais forte do mundo\" → `musu-tipi sami ni nuki`",
 "l16.922fb303": "igual",
 "l16.97f2a729": "\"o mais belo da floresta\"",
 "l16.9e4b4249": "Igualdade `tani-tani`",
 "l16.9f7115df": "menos (composto)",
 "l16.ad354042": "\"Mais doce que mel\" → `suma sa muma-mina-kuma`",
 "l16.cfd1e384": "Tapi",
 "l16.d24c94b7": "\"o maior\"",
 "l16.e4cd4556": "\"sou igual a ti em tamanho\"",
 "l16.e63995c3": "Superlativo `sami`",
 "l16.f2bb76ed": "\"Igual ao pai\" → `tani-tani papi`",
 "l16.f3cf4433": "Exercícios",
 "l17.04ad3ee6": "dez vezes",
 "l17.0d63db9d": "primeiro",
 "l17.0ed6011d": "duas vezes",
 "l17.1679091c": "6",
 "l17.26b5731e": "\"Cinco vezes ao dia\" → `ka-kapa pasi nupa`",
 "l17.2b7b1077": "segundo",
