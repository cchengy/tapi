 "l18.26255c47": "terça",
 "l18.2a3f41c2": "quinta",
 "l18.2f43b42f": "...",
 "l18.48f8c43d": "Estações",
 "l18.4ad462ef": "(Lista completa em [cultura.md](cultura.md))",
