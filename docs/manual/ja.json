 "l17.f3cf4433": "練習問題",
 "l17.f452fff3": "数",
 "l17.f899139d": "100",
 "l18.06e57a7d": "金曜日",
 "l18.0a249678": "夜：`muta-pi tina`",
 "l18.10cbe219": "月曜日",
 "l18.10fef620": "日本語",
 "l18.26255c47": "火曜日",
 "l18.2a3f41c2": "木曜日",
 "l18.2f43b42f": "…",
 "l18.48f8c43d": "季節",
 "l18.4ad462ef": "（完全なリストは [cultura.md](cultura.md)）",
 "l18.54edec8d": "一日の時間帯",
 "l18.6003a292": "「金曜の夜」→ `nupa-ma muta-pi`",
 "l18.61d90363": "「来年の春」→ `kipi-kapa kini`（直訳：新しい春）",
 "l18.635c1594": "「こんにちは、旦那様」→ `nupa tina, papi-sami`",
 "l18.66d17981": "正午",
 "l18.6d33d66f": "春（花-時間）",
 "l18.78ab84de": "1 月",
 "l18.7af763b2": "冬（寒い-時間）",
 "l18.84736276": "夜",
 "l18.8f647435": "午後",
 "l18.8febbfd1": "2 月",
 "l18.941016d5": "曜日",
 "l18.969d64f4": "朝",
 "l18.98f97844": "夏（暑い-時間）",
 "l18.99c8ef57": "夜明け",
 "l18.9a36cd6a": "午後：`nupa tina`",
 "l18.a42b3364": "別れ：`kuti tina`（良い帰り道）",
 "l18.ad5fb7bc": "水曜日",
 "l18.b32018bb": "時間帯ごとのあいさつ",
 "l18.be2fc0a0": "朝：`tunu-una tina`",
 "l18.bf957b38": "夕暮れ",
 "l18.cf1624fc": "3 月",
 "l18.cfd1e384": "Tapi",
 "l18.dc123bc5": "土曜日",
 "l18.e59da2d2": "12 月",
 "l18.e6694818": "秋（葉-落ちる）",
 "l18.e6a1c434": "月の名前（直訳：月-時間-X）",
 "l18.ecd42804": "レッスン 18 — 暦と時間",
 "l18.f3cf4433": "練習問題",
 "l18.f642fa88": "日曜日",
 "l18.f817c12d": "真夜中",
 "l19.12a0f2d6": "～してもらえますか？",
 "l19.2d54a2d4": "``` あなた：na! mi pa kima nani. tu puni ama-puna mi ku? あなた：こんにちは！道がわかりません。助けてもらえますか？",
 "l19.32023bc0": "うまくいっています",
 "l19.35b95baa": "元気です、ありがとう",
 "l19.3a077c79": "あいさつ",
 "l19.41691ce5": "お元気ですか（直訳：このように-様子）",
 "l19.470819ef": "レッスン 19 — 実践会話",
 "l19.4c8b7feb": "元気ですか？",
 "l19.55aee164": "3 通りの別れのあいさつをしてみましょう。",
 "l19.561c5caf": "あなた：tina-tina sami! あなた：どうもありがとうございます！ ```",
 "l19.610ad8d7": "モデル会話（観光客）",
 "l19.6d267c99": "頼みごと",
 "l19.70afc441": "～をください",
 "l19.740a78da": "またね（直訳：また-見る）",
 "l19.74c8f317": "別れのあいさつ",
 "l19.7646529c": "感謝と謝罪",
 "l19.79d50daa": "どういたしまして",
 "l19.7da3a6dc": "やあ（呼びかけ）",
 "l19.809e6b22": "～がほしい",
 "l19.83288a43": "はじめまして",
 "l19.91ef8b38": "あなたは？",
 "l19.925946e2": "道を尋ねてみましょう。",
 "l19.9ebb5c99": "自己紹介",
 "l19.a81f639d": "彼：ina-ti pasi nani-tipi mata, samu pasi ku-ti pinu-kapa. 彼：大通りを進んで、3 つ目の角を右です。",
 "l19.ad02875a": "どうもありがとうございます",
 "l19.b6583976": "あなた：mi ina ipa-tipi-kama. あなた：病院へ行きます。",
 "l19.d027e466": "ごめんなさい（直訳：言う-分ける）",
 "l19.e1654c11": "いつも元気",
 "l19.e5ebca86": "`mi ipa [名前]` = 私は[名前]です",
 "l19.f3cf4433": "練習問題",
 "l19.f5491d72": "ありがとう",
 "l19.fb10b733": "良い帰り道を",
 "l19.fd86eac4": "彼：mata-ipa. tu ina nika ku? 彼：もちろん。どこへ行きますか？",
 "l19.fe6f27fd": "Tapi で自己紹介してみましょう。",
 "l2.08176a75": "否定は動詞の前に `pa`：",
 "l2.10fef620": "日本語",
 "l2.15031bc0": "「彼らは人ですか？」→ `kupi ipa mati-mati ku`",
 "l2.1e6e6087": "単文：`主語 + 動詞 + 補語`。",
 "l2.202719a7": "私たち",
 "l2.31932660": "いいえ・～ない",
 "l2.38ba62ab": "彼/彼女",
 "l2.4a55b475": "語彙",
 "l2.672ca8c8": "あなたたち",
 "l2.697e5b10": "「私は人です」",
 "l2.717a42ba": "レッスン 2 — 私、あなた、彼",
 "l2.81346868": "（疑問の助詞）",
 "l2.8ba94fb6": "「あなたは男です」",
 "l2.955cb48d": "彼ら/彼女ら",
 "l2.9c1a1cf5": "「彼は良い」→ `si ipa tina`",
 "l2.c6682b48": "コピュラ `ipa` で「～である」：",
 "l2.cfd1e384": "Tapi",
 "l2.e03184d6": "「私たちは悪くない」→ `nupi pa ipa muka`",
 "l2.e5c3aa55": "文法",
 "l2.f3cf4433": "練習問題",
 "l2.f3efc625": "～である",
 "l2.f5bae9af": "「私は悪くない」",
 "l20.115f46f6": "`kama-tunu`（家-太陽）",
 "l20.12c5ae51": "器官-動作",
 "l20.260d58ea": "日当たりのいいベランダ",
 "l20.2e6e1a09": "**冷蔵庫** → ?",
 "l20.30f97a51": "例",
 "l20.3e60c065": "動作-対象",
 "l20.4966c32e": "原則",
 "l20.499afc2b": "作った言葉をコミュニティと共有しましょう。",
 "l20.4bdf449f": "レッスン 20 — 新しい言葉を作る",
 "l20.4cc1837a": "「saudade」（郷愁）→ `pumu-kana`（心 + 遠い）",
 "l20.511746aa": "場所-もの",
 "l20.523677e0": "食事",
 "l20.56f2fc07": "創作の例",
 "l20.66c9eed1": "写真",
 "l20.683511e7": "**誕生日** → ?",
 "l20.6cdaf07f": "要素の間に**ハイフン**",
 "l20.736875cf": "最終練習",
 "l20.761121ed": "翻訳",
 "l20.7642e793": "**適切な長さ**：2-5 要素",
 "l20.842ea432": "残りは**文脈**が補います",
 "l20.926addd7": "次の概念の Tapi 語を作りましょう：",
 "l20.99d610ec": "性質-もの",
 "l20.9c1c65b4": "「燃え尽き症候群」→ `puti-kupa-pa`（体-全部-否定）",
 "l20.9f02a72b": "**字面の意味**が概念を連想させること",
 "l20.a5efde29": "もの-機能",
 "l20.a6a31716": "発明する前に**既存の語根を使う**",
 "l20.aabc2217": "よくあるパターン",
 "l20.ad36fe14": "`tipi-mina`（大きい-水）",
 "l20.adcba148": "石の球",
 "l20.b1bb9b4c": "Tapi は**複合語の中に生きています**。言葉が足りなければ、組み立てる。",
 "l20.be31dfe5": "素材-形",
 "l20.be9b5ac7": "**未来へのサウダージ** → ?",
 "l20.c068e077": "**鏡** → ?",
 "l20.c29c85c0": "`tama-naku`（言葉-根）",
 "l20.c779cd57": "（参考案：`kasi-kama-pini` / `kupu-mapu-pita` / `nupa-sasu-kapa` / `pati-mapu` / `pumu-nupa-maku-ka`）",
 "l20.cc16a92b": "「人工知能」→ `patu-pita`（作られた + 考える）",
 "l20.cdeaabf1": "`mani-kasi`（食べる-食べ物）",
 "l20.d7114874": "`mapu-mana`（石-丸い）",
 "l20.da8f7ecf": "「インターネット」→ `tama-kupa`（言葉 + すべて）",
 "l20.e2effa3a": "パターン",
 "l20.e3de2cf8": "海",
 "l20.e6300758": "「自撮り」→ `pati-tika-ku`（写真 + 再帰）",
 "l20.ea32f911": "本",
 "l20.eee32656": "**アルゴリズム** → ?",
 "l20.fa942b2a": "「ポッドキャスト」→ `tama-na-tama-kupa`（歌 + インターネット、または tama-pami-kuta = 言葉-長い-取る）",
 "l20.fb72df4b": "`pati-tika`（目-見る）",
