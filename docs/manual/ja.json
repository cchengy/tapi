 "l17.6512bd43": "11",
 "l17.6d16b8d4": "基数",
 "l17.725f85b3": "第三",
 "l17.85af0095": "四分の一 (1/4)",
 "l17.8f14e45f": "7",
 "l17.91990a2f": "「三番目の子」→ `ku-ti kuni`",
 "l17.98f13708": "20",
 "l17.9e2875f6": "「半キロ」(½) → `tani-ni-pi`",
 "l17.a87ff679": "4",
