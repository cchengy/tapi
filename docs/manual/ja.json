{
 "l0.7860442e": "完全なコース。全 20 レッスン。各レッスン：語彙 + 文法 + 練習問題。",
 "l0.f382537f": "**レッスン 1-10**：基礎（発音 → 複合語）。**レッスン 11-20**：中級（使役、態、証拠性、敬語、従属節、比較級、上級数詞、暦、会話、語の創造）。",
 "l1.052f1d48": "「元気ですか？」",
 "l1.10fef620": "日本語",
 "l1.1900a5f7": "「こんにちは、あなた」",
 "l1.1b7e1d3a": "「か」(ka)",
 "l1.1f5520c6": "Tapi は 9 文字だけを使います：`a, i, u, k, m, n, p, s, t`。1 文字 = 1 音。例外なし。",
 "l1.219c89da": "「私は元気です」",
 "l1.260c46ca": "発音してみましょう：`mati-mati`、`tunu-puka`、`kapa-kupa`。",
 "l1.36a2c425": "こんにちは（呼びかけ）",
 "l1.3dba7809": "フレーズ",
 "l1.3f332ce5": "「さ」(sa)",
 "l1.44505746": "あなた",
 "l1.4829322d": "私",
 "l1.4a55b475": "語彙",
 "l1.50254161": "訳してみましょう：「あなたは悪いですか？」",
 "l1.5ca6fcff": "「た」(ta)",
 "l1.5ff50cfc": "「ぱ」(pa)",
 "l1.692c61d6": "「な」(na)",
 "l1.8b520c90": "音",
 "l1.8c5e32f4": "「う」(u)",
 "l1.97672199": "レッスン 1 — 発音とあいさつ",
 "l1.a7b2937d": "アクセントは常に後ろから 2 番目の音節：ka**ma**、pa**ti**、ta**pi**。",
 "l1.b30fe35f": "「ま」(ma)",
 "l1.b56c581c": "答え：`tu muka ku`",
 "l1.b791d552": "近い音",
 "l1.bc5694d9": "アクセントの規則",
 "l1.cfd1e384": "Tapi",
 "l1.e2e6c938": "良い",
 "l1.ec66b4a3": "「い」(i)",
 "l1.f3cf4433": "練習問題",
 "l1.fe986655": "文字",
 "l10.034f5409": "家-翼 = 飛行機",
 "l10.05bc7886": "心-大きい = 勇気",
 "l10.1be91db1": "「病院」→ `puti-tina-kama`（体-良い-家）または `naka-kama`",
 "l10.26a5abfd": "複雑な語 = 単純な語根をハイフンでつなぐ。",
 "l10.2aed2568": "太陽-火 = 熱",
 "l10.31f96331": "原理",
 "l10.404d5bef": "思考-長い",
 "l10.475c4209": "自分の言葉を作ろう",
 "l10.481e4a14": "「自転車」→ `mana-puta`（丸い-足）",
 "l10.55779eb1": "複合語を使って Tapi に訳しましょう：",
 "l10.56603e6d": "知る-与える = 先生",
 "l10.63f40b36": "古典的な例：",
 "l10.6b25bffe": "「空港」→ `kama-titu-kama`（飛行機-家）",
 "l10.732b452c": "例：「saudade」（サウダージ、切ない郷愁）には直接の単語がありません。可能な複合語：",
 "l10.736875cf": "最終練習",
 "l10.acaedb0a": "心-戻る",
 "l10.b2e8f164": "時間-否定",
 "l10.d426691e": "レッスン 10 — 複合語（Tapi の魂）",
 "l10.df5dd4a7": "言葉-長い = 電話",
 "l10.f5e910db": "「幸せ」→ `pumu-tina`",
 "l10.f78934c9": "語根を組み合わせて概念を作ります。話者は文脈で理解します。",
 "l11.10fef620": "日本語",
 "l11.18b7aedc": "「雨が植物を育てる」→ `masu patuka kipi tipi`",
 "l11.19b624e9": "「あなたは子供を眠らせるでしょう」",
 "l11.319ac7ae": "使役 = 「X させる」。Tapi では `patu`（する）+ 動詞。",
 "l11.3d3cd5cd": "時制は主動詞ではなく `patu` に付きます：",
 "l11.46dc33ac": "「母は子供を眠らせる」",
 "l11.4a55b475": "語彙",
 "l11.5153cd83": "レッスン 11 — 使役",
 "l11.67528e5a": "強いる（直訳：must-する）",
 "l11.7ddc9575": "「彼らは私を笑わせた」→ `kupi patuta mi tasi`",
 "l11.83d76e7f": "「先生は人に知らせる」（= 教える）",
 "l11.968db0cb": "殺す（= patu kina だが短い語根）",
 "l11.b3884c47": "「私は彼に食べさせた（昨日）」",
 "l11.bd3e0f5f": "する（使役）",
 "l11.c87c951b": "「私は彼に食べさせた」",
 "l11.cfd1e384": "Tapi",
 "l11.e5b8d17b": "構造",
 "l11.e87b32ab": "`主語 + patu + 対象 + 動詞`。",
 "l11.f3cf4433": "練習問題",
 "l12.04f3381b": "能動：`si mani kasi` = 「彼は食べ物を食べる」",
 "l12.0f1d861c": "「その本は多くの人によって書かれた」",
 "l12.12a28a47": "受動：`kasi mani-pa mu si` = 「食べ物は彼に食べられる」",
 "l12.2a3586b5": "「食べ物は彼に食べられた」",
 "l12.50f62116": "`目的語 + 動詞 + mu + 動作主`。",
 "l12.5e59093b": "「Suanu は母に見られた」→ `Suanu tikata mu mama`",
 "l12.ac4fb66f": "`mu` なし：非人称受動。",
 "l12.af87cd2c": "レッスン 12 — 受動態",
 "l12.c350c950": "「家が建てられた」（誰かは言わない）",
 "l12.c9595b8f": "主語と目的語を入れ替えます。助詞 `mu` が動作主を示します。",
 "l12.d75644fe": "「木が切り倒された」→ `tipa sasita`",
 "l12.d78a1d07": "動作主が不明のとき",
 "l12.e5b8d17b": "構造",
 "l12.f3cf4433": "練習問題",
 "l12.fbbc5ba4": "比較：",
 "l13.0ba520d3": "`manita-ni`（食べたはずだ — 汚れた皿を見た）",
 "l13.0e23e5c5": "∅（なし）",
 "l13.10fef620": "日本語",
 "l13.12efe565": "使いどころ",
 "l13.226ed3c2": "「眠ったのを見た」→ `napita`",
 "l13.30f97a51": "例",
 "l13.3107f050": "見る（直接証拠の語根）",
 "l13.34c4a1b8": "証拠から推測した",
 "l13.46e18882": "接尾辞",
 "l13.4a55b475": "語彙",
 "l13.4dc85172": "うわさ：`-ni-ku`（疑わしい）",
 "l13.4fe4525a": "`manita`（食べた、私は見た）",
 "l13.60694dcc": "「来たかもしれない」→ `unata-ni-ku`",
 "l13.75ddcd3e": "直接目撃：∅",
 "l13.86c5286f": "ニュース：`-ni-ni`（伝聞）",
 "l13.c0145067": "人から聞いた",
 "l13.c1c6bd7b": "調査：`-ni`（推測）",
 "l13.c20511da": "嘘（直訳：真実-否定）",
 "l13.c2d553f7": "疑わしい",
 "l13.c7efdebd": "真実",
 "l13.caf47c81": "`manita-ni-ni`（食べたと言われている）",
 "l13.ce14c060": "「雨が降ったそうだ」→ `masuta-ni-ni`",
 "l13.cfd1e384": "Tapi",
 "l13.d78e3c05": "直接見た・体験した",
 "l13.e781f99a": "`manita-ni-ku`（食べたかもしれない、わからない）",
 "l13.eba6c29c": "意味",
 "l13.f2f9dcc1": "話す内容を**どうやって知ったか**を示します。動詞に付きます（ふつう過去形）。",
 "l13.f3cf4433": "練習問題",
 "l13.f4c7f29d": "レッスン 13 — 証拠性",
 "l14.12efe565": "使いどころ",
 "l14.13f3c743": "丁寧な代名詞",
 "l14.19273190": "丁寧な呼びかけ",
 "l14.1b32db0e": "年上の見知らぬ人との初対面",
 "l14.1d1648e1": "レッスン 14 — 敬語",
 "l14.1d8c515b": "あなた様（丁寧、直訳:あなた-上位）",
 "l14.25885c21": "フォーマルな仕事の場",
 "l14.2747159c": "丁寧な言葉づかい。Tapi は接尾辞と専用の形を使います。",
 "l14.288029d0": "敬意の接尾辞 `-sami`",
 "l14.463969fc": "私（謙譲、直訳：私-小さい）",
 "l14.600f847a": "上司（敬称）",
 "l14.6658eaff": "「謹んで感謝いたします」→ `mi-puku taka-tina sami`",
 "l14.666980ce": "～さん・旦那様（直訳：父-上位）",
 "l14.82e94bb6": "社会的な名詞に付けます：",
 "l14.9693f6e3": "「おはようございます、奥様」→ `tunu-una tina, mama-sami`",
 "l14.9ae224d7": "先生（敬称）",
 "l14.a3f15aba": "儀式",
 "l14.ad1e45be": "フォーマルな文章（手紙、宣言）",
 "l14.b9762931": "親しい人や同輩の間では：ふつうの形。",
 "l14.d0a169f8": "`na, papi-sami` = 「旦那様、…」 `na, mama-sami` = 「奥様、…」",
 "l14.f3cf4433": "練習問題",
 "l14.ff01ff70": "奥様（直訳：母-上位）",
 "l15.0c27327a": "`mi tasi miku tu una`（あなたが来たから私は笑う）",
 "l15.12e52314": "「雨が降ったなら、私は行かなかった」",
 "l15.1b94a681": "時制は主節だけに — 従属節は文脈を引き継ぎます。",
 "l15.1f90884a": "`asi pa X, Y` = 「X がなければ Y」。",
 "l15.2e790236": "～する間",
 "l15.30f97a51": "例",
 "l15.3f1aac96": "「雨の間に勉強する」→ `mi kima-kapa pamu masu`",
 "l15.45f61d46": "なぜなら",
 "l15.6b4851f1": "時制の一致",
 "l15.6d10266d": "レッスン 15 — 従属節",
 "l15.6e7eb6ee": "～という（関係詞）",
 "l15.7354ba40": "`mati ta una`（来た人）",
 "l15.7a16c83f": "もし（条件）",
 "l15.805ea36c": "「あなたがいなければ、私は死ぬだろう」",
 "l15.83630a4b": "「食べ物があれば食べる」→ `mi manika asi mi nuta kasi`",
 "l15.970a9978": "`pamu tu napi, mi patu`（あなたが眠る間、私は働く）",
 "l15.9b91c524": "反実仮想の原因",
 "l15.abe326c1": "～するとき（一般）",
 "l15.c10746ea": "`asi tu una, mi tasi`（あなたが来たら、私は笑う）",
 "l15.cfd1e384": "Tapi",
 "l15.d908877d": "「あなたが来たとき、私は眠っていた」",
 "l15.df0cd085": "従属接続詞が文をつなぎます。",
 "l15.e2d7bba6": "「知っているから話す」→ `mi taka miku mi kima`",
 "l15.eba6c29c": "意味",
 "l15.f3cf4433": "練習問題",
 "l15.f4a2f89c": "`upa masu, mi mipa kama`（雨が降るとき、家にいる）",
 "l16.00b4bbb6": "レッスン 16 — 比較級と最上級",
 "l16.0330a512": "逆は `pa-sa` を使います。",
 "l16.10fef620": "日本語",
 "l16.14643cfd": "「私はあなたより遠くまで歩く」",
 "l16.156f04fd": "「この家はあの家より大きい」",
 "l16.43831b1e": "比較級 `sa`",
 "l16.45fa570b": "「私はあなたより小さい」（直訳：小さい「より少ない」あなた）",
 "l16.4a55b475": "語彙",
 "l16.5254e635": "最上級",
 "l16.620bb639": "比較級（もっと）",
 "l16.6bf24f1b": "形容詞に付けます。",
 "l16.8010c705": "`X sa Y` = 「X は Y より」。",
 "l16.8773dd44": "「世界で最も強い」→ `musu-tipi sami ni nuki`",
 "l16.922fb303": "等しい",
 "l16.97f2a729": "「森で最も美しい」",
 "l16.9e4b4249": "同等 `tani-tani`",
 "l16.9f7115df": "より少ない（複合語）",
 "l16.ad354042": "「蜂蜜より甘い」→ `suma sa muma-mina-kuma`",
 "l16.cfd1e384": "Tapi",
 "l16.d24c94b7": "「最も大きい」",
 "l16.e4cd4556": "「私はあなたと同じ大きさ」",
 "l16.e63995c3": "最上級 `sami`",
 "l16.f2bb76ed": "「父と同じ」→ `tani-tani papi`",
 "l16.f3cf4433": "練習問題",
 "l17.04ad3ee6": "十回",
 "l17.0d63db9d": "第一",
 "l17.0ed6011d": "二回",
 "l17.1679091c": "6",
 "l17.26b5731e": "「一日に五回」→ `ka-kapa pasi nupa`",
 "l17.2b7b1077": "第二",
 "l17.34173cb3": "30",
 "l17.3c59dc04": "21",
